[Unit]
Description=Reconcile managed GitHub repositories
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/daniele/.config/github-autosync/reconcile.env
WorkingDirectory=/home/daniele/projects/github-autosync
ExecStart=/home/daniele/.local/bin/github-reconcile
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/daniele/.local/state/codex-github-autosync /home/daniele/projects /home/daniele/MegaVault
StandardOutput=journal
StandardError=journal
